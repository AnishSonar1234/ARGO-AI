# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_actual_api_key_here
OPENROUTER_API=your_actual_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Server Configuration
PORT=5000

# ChromaDB Vector Database Configuration
# Option A: Chroma Cloud (https://cloud.trychroma.com)
CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=your_database_name_here

# Option B: Remote Hosted ChromaDB Instance (e.g. on Render/Railway/Docker)
# CHROMA_HOST=your-chroma-service.onrender.com
# CHROMA_PORT=443
# CHROMA_SSL=true
# CHROMA_AUTH_TOKEN=
